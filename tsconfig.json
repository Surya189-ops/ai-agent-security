{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "skipLibCheck": true,

    "sourceMap": true,

    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false
  },

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "src/index.backup.ts",
    "generate-agent-keys.ts",
    "setup-security-config.ts",
    "prisma/**/*.ts"
  ]
}